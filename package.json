{
	"name": "@ishan/ecosystem-core",
	"version": "0.5.0",
	"description": "Shared, injected core for the Ishan Parihar ecosystem surfaces: email transport, signed tokens, the subscriber store, a cache and KV-backed rate limiting, delivery metrics, a PostgREST client, the Razorpay client with its signature verifications, and role/tier session resolution. No SvelteKit virtual modules, no module-level singletons.",
	"private": true,
	"type": "module",
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ishan-parihar/ecosystem-core.git"
	},
	"engines": {
		"node": ">=20"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"src",
		"README.md",
		"CHANGELOG.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./email": {
			"types": "./dist/email/index.d.ts",
			"default": "./dist/email/index.js"
		},
		"./subscribers": {
			"types": "./dist/subscribers/index.d.ts",
			"default": "./dist/subscribers/index.js"
		},
		"./tokens": {
			"types": "./dist/tokens/index.d.ts",
			"default": "./dist/tokens/index.js"
		},
		"./monitoring": {
			"types": "./dist/monitoring/index.d.ts",
			"default": "./dist/monitoring/index.js"
		},
		"./cache": {
			"types": "./dist/cache/index.d.ts",
			"default": "./dist/cache/index.js"
		},
		"./data": {
			"types": "./dist/data/index.d.ts",
			"default": "./dist/data/index.js"
		},
		"./http": {
			"types": "./dist/http/index.d.ts",
			"default": "./dist/http/index.js"
		},
		"./payments": {
			"types": "./dist/payments/index.d.ts",
			"default": "./dist/payments/index.js"
		},
		"./auth": {
			"types": "./dist/auth/index.d.ts",
			"default": "./dist/auth/index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"check:semver": "node scripts/check-semver.mjs",
		"check:dist": "npm run build && git add -A dist && git diff --quiet -- dist",
		"check:ghosts": "node scripts/check-dist-ghosts.mjs",
		"check:consumers": "node scripts/check-consumer-matrix.mjs",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"contract": "node scripts/verify-contract.mjs",
		"verify": "npm run contract && npm run typecheck && npm run build && npm run test && npm run check:consumers && npm run check:dist && npm run check:ghosts && npm run check:semver",
		"prepare": "npm run build"
	},
	"devDependencies": {
		"typescript": "^5.7.0",
		"vitest": "^4.1.6"
	}
}
